{
  "name": "create-node-app",
  "version": "1.0.0",
  "description": "Interactive CLI for scaffolding production-ready Node.js backend applications with Express, Next.js, React, and TanStack, featuring fully configurable modules and project structure.",
  "keywords": [
    "cli",
    "scaffold",
    "scaffolding",
    "generator",
    "boilerplate",
    "starter",
    "node",
    "nodejs",
    "express",
    "nextjs",
    "tanstack",
    "typescript",
    "postgres",
    "postgresql",
    "mongodb",
    "drizzle",
    "prisma",
    "mongoose",
    "redis",
    "docker",
    "monorepo",
    "turborepo",
    "create-app",
    "project-generator"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown --watch",
    "format": "prettier --write \"**/*.{ts,json}\""
  },
  "bin": {
    "create-node-app": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/nodejsboilerplate/create-node-app.git"
  },
  "author": "Nimul Islam Mahin nimulmahin@gmail.com",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "@octokit/core": "^7.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
